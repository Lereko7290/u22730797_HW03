@model List<u22730797_HW03.Models.Product>
@{
    ViewBag.Title = "Product Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Product Management</h2>

<div class="card">
    <div class="card-header">
        <h5>All Products</h5>
    </div>
    <div class="card-body">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Product Name</th>
                    <th>Brand</th>
                    <th>Category</th>
                    <th>Model Year</th>
                    <th>Price</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in Model)
                {
                    <tr>
                        <td>@product.product_id</td>
                        <td>@product.product_name</td>
                        <td>@(product.Brand?.brand_name ?? "N/A")</td>
                        <td>@(product.Category?.category_name ?? "N/A")</td>
                        <td>@product.model_year</td>
                        <td>$@product.list_price</td>
                        <td>
                            @Html.ActionLink("Edit", "Edit", new { id = product.product_id }, new { @class = "btn btn-sm btn-warning" })
                            @Html.ActionLink("Delete", "Delete", new { id = product.product_id }, new { @class = "btn btn-sm btn-danger" })
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>