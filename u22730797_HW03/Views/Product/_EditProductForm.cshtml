
@model u22730797_HW03.Models.Product
@{
    var brands = ViewBag.Brands as List<u22730797_HW03.Models.Brand>;
    var categories = ViewBag.Categories as List<u22730797_HW03.Models.Category>;
}

@using (Html.BeginForm("Edit", "Product", FormMethod.Post, new { id = "editProductForm" }))
{
    @Html.HiddenFor(model => model.product_id)

    <div class="container-fluid">
        <div class="row">
            <div class="col-md-12">
                <div class="form-group">
                    @Html.LabelFor(model => model.product_name, "Product Name")
                    @Html.TextBoxFor(model => model.product_name, new { @class = "form-control" })
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.brand_id, "Brand")
                    @Html.DropDownListFor(model => model.brand_id,
                        new SelectList(brands, "brand_id", "brand_name"),
                        "Select Brand", new { @class = "form-control" })
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.category_id, "Category")
                    @Html.DropDownListFor(model => model.category_id,
                        new SelectList(categories, "category_id", "category_name"),
                        "Select Category", new { @class = "form-control" })
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.model_year, "Model Year")
                    @Html.TextBoxFor(model => model.model_year, new { @class = "form-control", type = "number" })
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.list_price, "Price")
                    @Html.TextBoxFor(model => model.list_price, new { @class = "form-control", type = "number", step = "0.01" })
                </div>
            </div>
        </div>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Update Product</button>
    </div>
}