@model List<u22730797_HW03.Models.Product>
@{
    ViewBag.Title = "Filtered Products";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Filtered Products</h2>

<div class="card">
    <div class="card-body">
        @if (Model != null && Model.Any())
        {
            foreach (var product in Model)
            {
                <div class="mb-2 p-2 border-bottom">
                    <strong>@product.product_name</strong><br>
                    <small class="text-muted">@(product.Brand?.brand_name ?? "N/A") - @(product.Category?.category_name ?? "N/A")</small><br>
                    <small class="text-muted">$@product.list_price - @product.model_year</small>
                </div>
            }
        }
        else
        {
            <p>No products found</p>
        }
    </div>
</div>

<div class="mt-3">
    @Html.ActionLink("Back to Home", "Index", "Home", null, new { @class = "btn btn-secondary" })
</div>