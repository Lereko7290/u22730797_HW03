@model List<u22730797_HW03.Controllers.ArchiveFileModel>
@{
    ViewBag.Title = "Report Archive";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Report Archive</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<div class="card">
    <div class="card-header bg-warning text-dark">
        <h5><i class="fas fa-archive"></i> Saved Reports</h5>
    </div>
    <div class="card-body">
        @if (Model != null && Model.Count > 0)
        {
            <div class="list-group">
                @foreach (var file in Model)
                {
                    <div class="list-group-item">
                        <div class="d-flex justify-content-between align-items-start">
                            <div class="flex-grow-1">
                                <h6 class="mb-1">@file.FileName</h6>
                                <p class="mb-1 small text-muted">@file.Description</p>
                                <small class="text-muted">
                                    Created: @file.CreatedDate.ToString("yyyy-MM-dd HH:mm") |
                                    Type: @file.FileType.ToUpper() |
                                    Size: @((file.FileSize / 1024.0).ToString("F2")) KB
                                </small>
                            </div>
                            <div class="btn-group-vertical ml-2">
                                @Html.ActionLink("Download", "DownloadFile", new { fileName = file.FileName }, new { @class = "btn btn-success btn-sm mb-1" })
                                @Html.ActionLink("Delete", "DeleteFile", new { fileName = file.FileName },
                                    new
                                         {
                                        @class = "btn btn-danger btn-sm",
                                        onclick = $"return confirm('Are you sure you want to delete {file.FileName}? This action cannot be undone.');"
                                    })
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="text-muted">No saved reports yet. Generate and save a report to see it here.</p>
        }
    </div>
</div>

<div class="mt-3">
    @Html.ActionLink("Back to Reports", "Index", "Report", null, new { @class = "btn btn-secondary" })
    @Html.ActionLink("Generate New Report", "Index", "Report", null, new { @class = "btn btn-primary" })
</div>