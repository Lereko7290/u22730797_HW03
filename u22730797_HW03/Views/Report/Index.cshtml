@{
    ViewBag.Title = "Reports";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Reports Dashboard</h2>

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h5><i class="fas fa-chart-bar"></i> Generate Business Reports</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="font-weight-bold">Select Report Type:</label>
                            <select class="form-control" id="reportType">
                                <option value="sales">Current Sales Report</option>
                                <option value="popular">Popular Products Report</option>
                                <option value="stock">Stock Items Report</option>
                                <option value="staff">Staff Performance Report</option>
                                <option value="frequency">Sales Frequency Report</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="font-weight-bold">Chart Type:</label>
                            <select class="form-control" id="chartType">
                                <option value="bar">Bar Chart</option>
                                <option value="line">Line Chart</option>
                                <option value="pie">Pie Chart</option>
                                <option value="doughnut">Doughnut Chart</option>
                            </select>
                        </div>
                    </div>
                </div>

                <button class="btn btn-primary btn-lg btn-block" onclick="generateReport()">
                    <i class="fas fa-play"></i> Generate Report
                </button>

                <div id="reportResults" class="mt-4" style="display: none;">
                    <div class="card">
                        <div class="card-header bg-success text-white">
                            <h6 id="reportTitle">Report Results</h6>
                        </div>
                        <div class="card-body">
                            <canvas id="reportChart" width="400" height="200"></canvas>
                            <div id="reportTable" class="mt-3 table-responsive"></div>
                        </div>
                    </div>
                </div>

                <div id="saveReportSection" class="mt-4" style="display: none;">
                    <div class="card">
                        <div class="card-header bg-info text-white">
                            <h6><i class="fas fa-save"></i> Export & Save Report</h6>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label class="font-weight-bold">File Name:</label>
                                        <input type="text" class="form-control" id="fileName" placeholder="Enter file name">
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label class="font-weight-bold">File Type:</label>
                                        <select class="form-control" id="fileType">
                                            <option value="txt">Text File (.txt)</option>
                                            <option value="csv">CSV File (.csv)</option>
                                            <option value="json">JSON File (.json)</option>
                                            <option value="pdf">PDF Document (.pdf)</option>
                                            <option value="docx">Word Document (.docx)</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label class="font-weight-bold">File Preview:</label>
                                        <div class="form-control-plaintext">
                                            <small class="text-muted" id="filePreview">.txt file</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="font-weight-bold">Report Description:</label>
                                <textarea class="form-control" id="description" rows="3" placeholder="Enter a detailed description of this report..."></textarea>
                            </div>
                            <button class="btn btn-success btn-lg" onclick="saveReportWithDescription()">
                                <i class="fas fa-file-export"></i> Export & Save Report
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header bg-warning text-dark">
                <h5><i class="fas fa-archive"></i> Document Archive</h5>
            </div>
            <div class="card-body">
                <div id="archiveList">
                    <p class="text-muted">No saved reports yet. Generate and save a report to see it here.</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/Scripts/Chart.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

    <script>
        const { jsPDF } = window.jspdf;
        let currentChart = null;
        let currentReportData = null;
        let currentReportType = null;

        $(document).ready(function () {
            loadArchive();

            $('#fileType').change(function () {
                const type = $(this).val();
                let preview = '';
                switch (type) {
                    case 'pdf': preview = 'PDF document with chart and data'; break;
                    case 'docx': preview = 'Word document with rich formatting'; break;
                    case 'csv': preview = 'Comma-separated values for Excel'; break;
                    case 'json': preview = 'JSON data file for developers'; break;
                    default: preview = 'Plain text file'; break;
                }
                $('#filePreview').text(preview);
            });
        });

        function generateReport() {
            const reportType = $('#reportType').val();
            currentReportType = reportType;

            $('#reportResults').show();
            $('#saveReportSection').hide();

            switch (reportType) {
                case 'sales':
                    generateSalesReport();
                    break;
                case 'popular':
                    generatePopularProductsReport();
                    break;
                case 'stock':
                    generateStockReport();
                    break;
                case 'staff':
                    generateStaffPerformanceReport();
                    break;
                case 'frequency':
                    generateSalesFrequencyReport();
                    break;
            }
        }

        function generateSalesReport() {
            $.get('/Report/SalesReport', function (data) {
                currentReportData = data;
                displaySalesChart(data);
                displaySalesTable(data);
                $('#reportTitle').text('Current Sales Report - Last 100 Transactions');
                $('#saveReportSection').show();
            });
        }

        function generatePopularProductsReport() {
            $.get('/Report/PopularProductsReport', function (data) {
                currentReportData = data;
                displayPopularProductsChart(data);
                displayPopularProductsTable(data);
                $('#reportTitle').text('Popular Products Report - Top 15 Products');
                $('#saveReportSection').show();
            });
        }

        function generateStockReport() {
            $.get('/Report/StockReport', function (data) {
                currentReportData = data;
                displayStockChart(data);
                displayStockTable(data);
                $('#reportTitle').text('Stock Items Report - Available Products');
                $('#saveReportSection').show();
            });
        }

        function generateStaffPerformanceReport() {
            $.get('/Report/StaffPerformanceReport', function (data) {
                currentReportData = data;
                displayStaffPerformanceChart(data);
                displayStaffPerformanceTable(data);
                $('#reportTitle').text('Staff Performance Ranking');
                $('#saveReportSection').show();
            });
        }

        function generateSalesFrequencyReport() {
            $.get('/Report/SalesFrequencyReport', function (data) {
                currentReportData = data;
                displaySalesFrequencyChart(data);
                displaySalesFrequencyTable(data);
                $('#reportTitle').text('Sales Frequency Report - Monthly Trends');
                $('#saveReportSection').show();
            });
        }

        function displaySalesChart(data) {
            const chartType = $('#chartType').val();
            const ctx = document.getElementById('reportChart').getContext('2d');

            if (currentChart) currentChart.destroy();

            currentChart = new Chart(ctx, {
                type: chartType,
                data: {
                    labels: data.slice(0, 10).map(item => item.ProductName),
                    datasets: [{
                        label: 'Sales Quantity',
                        data: data.slice(0, 10).map(item => item.Quantity),
                        backgroundColor: 'rgba(54, 162, 235, 0.5)',
                        borderColor: 'rgba(54, 162, 235, 1)',
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        title: {
                            display: true,
                            text: 'Top 10 Products by Sales Quantity'
                        }
                    }
                }
            });
        }

        function displayPopularProductsChart(data) {
            const chartType = $('#chartType').val();
            const ctx = document.getElementById('reportChart').getContext('2d');

            if (currentChart) currentChart.destroy();

            currentChart = new Chart(ctx, {
                type: chartType,
                data: {
                    labels: data.map(item => item.ProductName),
                    datasets: [{
                        label: 'Total Units Sold',
                        data: data.map(item => item.TotalSold),
                        backgroundColor: 'rgba(255, 99, 132, 0.5)',
                        borderColor: 'rgba(255, 99, 132, 1)',
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        title: {
                            display: true,
                            text: 'Most Popular Products by Sales Volume'
                        }
                    }
                }
            });
        }

        function displayStockChart(data) {
            const chartType = $('#chartType').val();
            const ctx = document.getElementById('reportChart').getContext('2d');

            if (currentChart) currentChart.destroy();

            const groupedData = groupStockItemsByBrand(data);
            const backgroundColors = generateDistinctColors(groupedData.labels.length);

            currentChart = new Chart(ctx, {
                type: chartType,
                data: {
                    labels: groupedData.labels,
                    datasets: [{
                        label: 'Quantity in Stock',
                        data: groupedData.quantities,
                        backgroundColor: backgroundColors,
                        borderColor: backgroundColors.map(color => color.replace('0.7', '1')),
                        borderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        title: {
                            display: true,
                            text: 'Current Stock Levels (Grouped by Brand)'
                        },
                        legend: {
                            position: 'right',
                            labels: {
                                font: {
                                    size: 12
                                }
                            }
                        },
                        tooltip: {
                            callbacks: {
                                label: function (context) {
                                    const label = context.label || '';
                                    const value = context.raw || 0;
                                    const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                    const percentage = Math.round((value / total) * 100);
                                    return `${label}: ${value} items (${percentage}%)`;
                                }
                            }
                        }
                    }
                }
            });
        }

        function displayStaffPerformanceChart(data) {
            const chartType = $('#chartType').val();
            const ctx = document.getElementById('reportChart').getContext('2d');

            if (currentChart) currentChart.destroy();

            currentChart = new Chart(ctx, {
                type: chartType,
                data: {
                    labels: data.map(item => item.StaffName),
                    datasets: [{
                        label: 'Total Revenue ($)',
                        data: data.map(item => item.TotalRevenue),
                        backgroundColor: 'rgba(153, 102, 255, 0.5)',
                        borderColor: 'rgba(153, 102, 255, 1)',
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        title: {
                            display: true,
                            text: 'Staff Performance by Revenue Generated'
                        }
                    }
                }
            });
        }

        function displaySalesFrequencyChart(data) {
            const ctx = document.getElementById('reportChart').getContext('2d');

            if (currentChart) currentChart.destroy();

            currentChart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: data.map(item => item.Period),
                    datasets: [{
                        label: 'Total Sales',
                        data: data.map(item => item.TotalSales),
                        backgroundColor: 'rgba(255, 159, 64, 0.5)',
                        borderColor: 'rgba(255, 159, 64, 1)',
                        borderWidth: 1,
                        fill: false
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        title: {
                            display: true,
                            text: 'Monthly Sales Trends'
                        }
                    }
                }
            });
        }

        function displaySalesTable(data) {
            let tableHtml = '<table class="table table-striped table-bordered"><thead class="thead-dark"><tr><th>Product</th><th>Customer</th><th>Staff</th><th>Quantity</th><th>Price</th><th>Date</th></tr></thead><tbody>';
            data.slice(0, 20).forEach(item => {
                tableHtml += `<tr>
                        <td>${item.ProductName}</td>
                        <td>${item.CustomerName}</td>
                        <td>${item.StaffName}</td>
                        <td>${item.Quantity}</td>
                        <td>$${item.Price.toFixed(2)}</td>
                        <td>${new Date(item.OrderDate).toLocaleDateString()}</td>
                    </tr>`;
            });
            tableHtml += '</tbody></table>';
            $('#reportTable').html(tableHtml);
        }

        function displayPopularProductsTable(data) {
            let tableHtml = '<table class="table table-striped table-bordered"><thead class="thead-dark"><tr><th>Product</th><th>Total Sold</th><th>Total Revenue</th></tr></thead><tbody>';
            data.forEach(item => {
                tableHtml += `<tr>
                        <td>${item.ProductName}</td>
                        <td>${item.TotalSold}</td>
                        <td>$${item.TotalRevenue.toFixed(2)}</td>
                    </tr>`;
            });
            tableHtml += '</tbody></table>';
            $('#reportTable').html(tableHtml);
        }

        function displayStockTable(data) {
            const groupedData = groupStockItemsByBrand(data);

            let tableHtml = '<h6>Stock Summary by Brand</h6>';
            tableHtml += '<table class="table table-striped table-bordered"><thead class="thead-dark"><tr><th>Brand</th><th>Total Stock Quantity</th><th>Percentage</th></tr></thead><tbody>';

            const total = groupedData.quantities.reduce((sum, qty) => sum + qty, 0);

            groupedData.labels.forEach((label, index) => {
                const quantity = groupedData.quantities[index];
                const percentage = ((quantity / total) * 100).toFixed(1);
                tableHtml += `<tr>
                        <td><strong>${label}</strong></td>
                        <td>${quantity} items</td>
                        <td>${percentage}%</td>
                    </tr>`;
            });

            tableHtml += `<tr class="table-info">
                    <td><strong>TOTAL</strong></td>
                    <td><strong>${total} items</strong></td>
                    <td><strong>100%</strong></td>
                </tr>`;
            tableHtml += '</tbody></table>';

            tableHtml += '<h6 class="mt-4">Detailed Stock Items</h6>';
            tableHtml += '<table class="table table-sm table-bordered"><thead class="thead-light"><tr><th>Product Name</th><th>Brand</th><th>Category</th><th>Stock Qty</th><th>Price</th></tr></thead><tbody>';

            data.slice(0, 20).forEach(item => {
                tableHtml += `<tr>
                        <td>${item.ProductName}</td>
                        <td>${item.Brand}</td>
                        <td>${item.Category}</td>
                        <td>${item.QuantityInStock}</td>
                        <td>$${item.ListPrice ? item.ListPrice.toFixed(2) : '0.00'}</td>
                    </tr>`;
            });

            tableHtml += '</tbody></table>';

            $('#reportTable').html(tableHtml);
        }

        function displayStaffPerformanceTable(data) {
            let tableHtml = '<table class="table table-striped table-bordered"><thead class="thead-dark"><tr><th>Staff Name</th><th>Total Sales</th><th>Total Revenue</th><th>Order Count</th></tr></thead><tbody>';
            data.forEach(item => {
                tableHtml += `<tr>
                        <td>${item.StaffName}</td>
                        <td>${item.TotalSales}</td>
                        <td>$${item.TotalRevenue.toFixed(2)}</td>
                        <td>${item.OrderCount}</td>
                    </tr>`;
            });
            tableHtml += '</tbody></table>';
            $('#reportTable').html(tableHtml);
        }

        function displaySalesFrequencyTable(data) {
            let tableHtml = '<table class="table table-striped table-bordered"><thead class="thead-dark"><tr><th>Period</th><th>Total Sales</th><th>Total Orders</th><th>Total Revenue</th></tr></thead><tbody>';
            data.forEach(item => {
                tableHtml += `<tr>
                        <td>${item.Period}</td>
                        <td>${item.TotalSales}</td>
                        <td>${item.TotalOrders}</td>
                        <td>$${item.TotalRevenue.toFixed(2)}</td>
                    </tr>`;
            });
            tableHtml += '</tbody></table>';
            $('#reportTable').html(tableHtml);
        }

        function groupStockItemsByBrand(stockData) {
            const groups = {};

            stockData.forEach(item => {
                const brand = item.Brand || 'Unknown Brand';
                if (!groups[brand]) {
                    groups[brand] = 0;
                }
                groups[brand] += item.QuantityInStock;
            });

            const labels = Object.keys(groups);
            const quantities = Object.values(groups);

            return { labels, quantities };
        }

        function generateDistinctColors(count) {
            const baseColors = [
                'rgba(255, 99, 132, 0.7)',
                'rgba(54, 162, 235, 0.7)',
                'rgba(255, 205, 86, 0.7)',
                'rgba(75, 192, 192, 0.7)',
                'rgba(153, 102, 255, 0.7)',
                'rgba(255, 159, 64, 0.7)',
                'rgba(199, 199, 199, 0.7)',
                'rgba(83, 102, 255, 0.7)',
                'rgba(40, 159, 64, 0.7)',
                'rgba(210, 105, 30, 0.7)',
                'rgba(220, 20, 60, 0.7)',
                'rgba(0, 128, 128, 0.7)',
                'rgba(138, 43, 226, 0.7)',
                'rgba(60, 179, 113, 0.7)',
                'rgba(255, 140, 0, 0.7)'
            ];

            return baseColors.slice(0, count);
        }

        async function saveReportWithDescription() {
            const fileName = $('#fileName').val();
            const fileType = $('#fileType').val();
            const description = $('#description').val();

            if (!fileName) {
                alert('Please enter a file name');
                return;
            }

            const btn = event.target;
            const originalText = btn.innerHTML;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Exporting...';
            btn.disabled = true;

            try {
                if (fileType.toLowerCase() === 'pdf') {
                    await generatePdfWithChart(fileName, description);
                } else {
                    let reportContent = generateReportContent();
                    await saveTextReport(reportContent, fileName, fileType, description);
                    alert('Report saved successfully!');
                    $('#fileName').val('');
                    $('#description').val('');
                    loadArchive();
                }
            } catch (error) {
                alert('Error saving report: ' + error.message);
            } finally {
                btn.innerHTML = originalText;
                btn.disabled = false;
            }
        }

        async function generatePdfWithChart(fileName, description) {
            const pdf = new jsPDF();
            const pageWidth = pdf.internal.pageSize.getWidth();

            pdf.setFontSize(20);
            pdf.text('Bike Stores Business Report', pageWidth / 2, 20, { align: 'center' });

            pdf.setFontSize(12);
            pdf.text(`Generated: ${new Date().toLocaleString()}`, 20, 35);
            pdf.text(`Report: ${$('#reportType option:selected').text()}`, 20, 45);

            if (description) {
                pdf.text(`Description: ${description}`, 20, 55);
            }

            if (currentChart) {
                const chartCanvas = document.getElementById('reportChart');
                const chartImage = await html2canvas(chartCanvas);
                const imgData = chartImage.toDataURL('image/png');

                pdf.addImage(imgData, 'PNG', 20, 65, pageWidth - 40, 80);
            }

            let yPosition = 160;
            pdf.setFontSize(10);

            const tableData = getTableDataForPdf();

            pdf.setFillColor(240, 240, 240);
            pdf.rect(20, yPosition, pageWidth - 40, 10, 'F');
            pdf.setTextColor(0, 0, 0);
            pdf.setFont(undefined, 'bold');

            tableData.headers.forEach((header, index) => {
                const xPos = 25 + (index * ((pageWidth - 50) / tableData.headers.length));
                pdf.text(header, xPos, yPosition + 7);
            });

            yPosition += 12;

            pdf.setFont(undefined, 'normal');
            tableData.rows.forEach(row => {
                if (yPosition > 270) {
                    pdf.addPage();
                    yPosition = 20;
                }

                row.forEach((cell, index) => {
                    const xPos = 25 + (index * ((pageWidth - 50) / tableData.headers.length));
                    const cellText = cell.toString().length > 30 ? cell.toString().substring(0, 30) + '...' : cell.toString();
                    pdf.text(cellText, xPos, yPosition + 7);
                });
                yPosition += 8;
            });

            pdf.save(fileName + '.pdf');

            const reportContent = generateReportContent();
            await saveTextReport(reportContent, fileName, 'pdf', description);

            alert('PDF report downloaded successfully!');
            $('#fileName').val('');
            $('#description').val('');
            loadArchive();
        }

        function getTableDataForPdf() {
            const table = document.querySelector('#reportTable table');
            if (!table) {
                return { headers: ['Data'], rows: [['No table data available']] };
            }

            const headers = [];
            const rows = [];

            const headerCells = table.querySelectorAll('thead th');
            headerCells.forEach(header => {
                headers.push(header.textContent.trim());
            });

            const dataRows = table.querySelectorAll('tbody tr');
            dataRows.forEach(row => {
                const rowData = [];
                const cells = row.querySelectorAll('td');
                cells.forEach(cell => {
                    rowData.push(cell.textContent.trim());
                });
                rows.push(rowData);
            });

            return { headers, rows };
        }

        async function saveTextReport(reportContent, fileName, fileType, description) {
            return new Promise((resolve, reject) => {
                $.ajax({
                    url: '/Report/SaveReportWithDescription',
                    type: 'POST',
                    data: {
                        reportData: reportContent,
                        fileName: fileName,
                        fileType: fileType,
                        description: description
                    },
                    success: function (response) {
                        if (response.success) {
                            resolve(response);
                        } else {
                            reject(new Error(response.error));
                        }
                    },
                    error: function (xhr, status, error) {
                        reject(new Error(error));
                    }
                });
            });
        }

        function generateReportContent() {
            let content = `Report Type: ${$('#reportType option:selected').text()}\n`;
            content += `Generated: ${new Date().toLocaleString()}\n`;
            content += `Description: ${$('#description').val()}\n\n`;

            if (currentReportType === 'sales') {
                content += 'CURRENT SALES REPORT\n';
                content += 'Product,Customer,Staff,Quantity,Price,Date\n';
                currentReportData.slice(0, 50).forEach(item => {
                    content += `${item.ProductName},${item.CustomerName},${item.StaffName},${item.Quantity},${item.Price},${item.OrderDate}\n`;
                });
            } else if (currentReportType === 'popular') {
                content += 'POPULAR PRODUCTS REPORT\n';
                content += 'Product,Total Sold,Total Revenue\n';
                currentReportData.forEach(item => {
                    content += `${item.ProductName},${item.TotalSold},${item.TotalRevenue}\n`;
                });
            } else if (currentReportType === 'stock') {
                content += 'STOCK ITEMS REPORT\n';
                content += 'Product,Brand,Category,Quantity,Price\n';
                currentReportData.slice(0, 50).forEach(item => {
                    content += `${item.ProductName},${item.Brand},${item.Category},${item.QuantityInStock},${item.ListPrice}\n`;
                });
            } else if (currentReportType === 'staff') {
                content += 'STAFF PERFORMANCE REPORT\n';
                content += 'Staff Name,Total Sales,Total Revenue,Order Count\n';
                currentReportData.forEach(item => {
                    content += `${item.StaffName},${item.TotalSales},${item.TotalRevenue},${item.OrderCount}\n`;
                });
            } else if (currentReportType === 'frequency') {
                content += 'SALES FREQUENCY REPORT\n';
                content += 'Period,Total Sales,Total Orders,Total Revenue\n';
                currentReportData.forEach(item => {
                    content += `${item.Period},${item.TotalSales},${item.TotalOrders},${item.TotalRevenue}\n`;
                });
            }

            return content;
        }

        function loadArchive() {
            $.get('/Report/GetSavedReportsWithDetails', function (files) {
                let archiveHtml = '';

                if (files.length === 0) {
                    archiveHtml = '<p class="text-muted">No saved reports yet. Generate and save a report to see it here.</p>';
                } else {
                    archiveHtml = '<div class="list-group">';
                    files.forEach(file => {
                        const fileSize = (file.FileSize / 1024).toFixed(2) + ' KB';

                        archiveHtml += `<div class="list-group-item">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div class="flex-grow-1">
                                        <h6 class="mb-1">${file.FileName}</h6>
                                        <p class="mb-1 small text-muted">${file.Description}</p>
                                        <small class="text-muted">
                                            Created: ${new Date(file.CreatedDate).toLocaleString()} |
                                            Type: ${file.FileType} |
                                            Size: ${fileSize}
                                        </small>
                                    </div>
                                    <div class="btn-group-vertical ml-2">
                                        <button class="btn btn-success btn-sm mb-1" onclick="downloadFile('${file.FileName}')" title="Download ${file.FileName}">
                                            <i class="fas fa-download"></i> Download
                                        </button>
                                        <button class="btn btn-danger btn-sm" onclick="deleteFile('${file.FileName}')" title="Delete ${file.FileName}">
                                            <i class="fas fa-trash"></i> Delete
                                        </button>
                                    </div>
                                </div>
                            </div>`;
                    });
                    archiveHtml += '</div>';
                }

                $('#archiveList').html(archiveHtml);
            });
        }

        function downloadFile(fileName) {
            const btn = event.target;
            const originalText = btn.innerHTML;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
            btn.disabled = true;

            setTimeout(() => {
                window.open('/Report/DownloadFile?fileName=' + encodeURIComponent(fileName), '_blank');
                btn.innerHTML = originalText;
                btn.disabled = false;
            }, 500);
        }

        function deleteFile(fileName) {
            if (confirm('Are you sure you want to delete "' + fileName + '"? This action cannot be undone.')) {
                const btn = event.target;
                const originalText = btn.innerHTML;
                btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
                btn.disabled = true;

                $.post('/Report/DeleteFile', { fileName: fileName }, function (response) {
                    if (response.success) {
                        loadArchive();
                        const alertDiv = $('<div class="alert alert-success alert-dismissible fade show" role="alert">' +
                            '<strong>Success!</strong> File "' + fileName + '" has been deleted.' +
                            '<button type="button" class="close" data-dismiss="alert">×</button>' +
                            '</div>');
                        $('#archiveList').before(alertDiv);
                    } else {
                        alert('Error deleting file: ' + response.error);
                    }
                    btn.innerHTML = originalText;
                    btn.disabled = false;
                });
            }
        }
    </script>
}