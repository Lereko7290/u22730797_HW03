@{
    ViewBag.Title = "Business Intelligence Reports";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2> Reports</h2>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<div class="row">
    <!-- Report Selection -->
    <div class="col-md-8">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h5><i class="fas fa-chart-bar"></i> Generate Business Reports</h5>
            </div>
            <div class="card-body">
                @using (Html.BeginForm("GenerateReport", "Report", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="font-weight-bold">Report Type:</label>
                                <select class="form-control" name="ReportType" id="ReportType" required>
                                    <option value="">Select Report Type</option>
                                    <option value="sales">Current Sales Report</option>
                                    <option value="popular">Popular Products Report</option>
                                    <option value="stock">Stock Items Report</option>
                                    <option value="staff">Staff Performance Ranking</option>
                                    <option value="frequency">Sales Frequency Report</option>
                                    <option value="customer">Customer Performance Ranking</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="font-weight-bold">Chart Type:</label>
                                <select class="form-control" name="ChartType" id="ChartType">
                                    <option value="bar">Bar Chart</option>
                                    <option value="line">Line Chart</option>
                                    <option value="pie">Pie Chart</option>
                                    <option value="doughnut">Doughnut Chart</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <button type="submit" class="btn btn-primary btn-lg">
                            <i class="fas fa-play"></i> Generate Report
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Quick Stats -->
    <div class="col-md-4">
        <div class="card">
            <div class="card-header bg-info text-white">
                <h5><i class="fas fa-tachometer-alt"></i> Quick Stats</h5>
            </div>
            <div class="card-body">
                <div class="text-center">
                    <h6>Total Products: @ViewBag.TotalProducts</h6>
                    <h6>Total Customers: @ViewBag.TotalCustomers</h6>
                    <h6>Total Staff: @ViewBag.TotalStaff</h6>
                    <h6>Total Sales: @ViewBag.TotalSales</h6>
                </div>
                <div class="mt-3">
                    @Html.ActionLink("View Archive", "Archive", "Report", null, new { @class = "btn btn-outline-info btn-sm btn-block" })
                </div>
            </div>
        </div>
    </div>
</div>