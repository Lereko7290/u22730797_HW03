@model u22730797_HW03.Models.MaintainViewModel
@{
    ViewBag.Title = "Maintain Records";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-md-12">
        <h1>Maintain Records</h1>
        <p class="lead">Manage Staff, Customers, and Products</p>
    </div>
</div>

<div class="row mt-4">
    <!-- Staff Section -->
    <div class="col-md-4">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="mb-0">Staff Management</h5>
                    <small class="text-muted">Page @Model.StaffPage of @Model.StaffTotalPages</small>
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Phone</th>
                                <th>Active</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var staff in Model.Staffs)
                            {
                                <tr>
                                    <td>@staff.first_name @staff.last_name</td>
                                    <td>@staff.email</td>
                                    <td>@staff.phone</td>
                                    <td>@(staff.active == 1 ? "Yes" : "No")</td>
                                    <td>
                                        @Html.ActionLink("Edit", "EditStaff", new { id = staff.staff_id }, new { @class = "btn btn-sm btn-warning" })
                                        @Html.ActionLink("Delete", "DeleteStaff", new { id = staff.staff_id }, new { @class = "btn btn-sm btn-danger" })
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Staff Pagination -->
                @if (Model.StaffTotalPages > 1)
                {
                    <div class="d-flex justify-content-between align-items-center mt-3">
                        <div>
                            @if (Model.StaffPage > 1)
                            {
                                @Html.ActionLink("← Previous", "Index", new
                                {
                                    staffPage = Model.StaffPage - 1,
                                    customerPage = Model.CustomerPage,
                                    productPage = Model.ProductPage
                                }, new { @class = "btn btn-outline-secondary btn-sm" })
                            }
                        </div>

                        <small class="text-muted">Page @Model.StaffPage of @Model.StaffTotalPages</small>

                        <div>
                            @if (Model.StaffPage < Model.StaffTotalPages)
                            {
                                @Html.ActionLink("Next →", "Index", new
                                {
                                    staffPage = Model.StaffPage + 1,
                                    customerPage = Model.CustomerPage,
                                    productPage = Model.ProductPage
                                }, new { @class = "btn btn-outline-secondary btn-sm" })
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Customer Section -->
    <div class="col-md-4">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="mb-0">Customer Management</h5>
                    <small class="text-muted">Page @Model.CustomerPage of @Model.CustomerTotalPages</small>
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Phone</th>
                                <th>City</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var customer in Model.Customers)
                            {
                                <tr>
                                    <td>@customer.first_name @customer.last_name</td>
                                    <td>@customer.email</td>
                                    <td>@customer.phone</td>
                                    <td>@customer.city</td>
                                    <td>
                                        @Html.ActionLink("Edit", "EditCustomer", new { id = customer.customer_id }, new { @class = "btn btn-sm btn-warning" })
                                        @Html.ActionLink("Delete", "DeleteCustomer", new { id = customer.customer_id }, new { @class = "btn btn-sm btn-danger" })
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Customer Pagination -->
                @if (Model.CustomerTotalPages > 1)
                {
                    <div class="d-flex justify-content-between align-items-center mt-3">
                        <div>
                            @if (Model.CustomerPage > 1)
                            {
                                @Html.ActionLink("← Previous", "Index", new
                                {
                                    staffPage = Model.StaffPage,
                                    customerPage = Model.CustomerPage - 1,
                                    productPage = Model.ProductPage
                                }, new { @class = "btn btn-outline-secondary btn-sm" })
                            }
                        </div>

                        <small class="text-muted">Page @Model.CustomerPage of @Model.CustomerTotalPages</small>

                        <div>
                            @if (Model.CustomerPage < Model.CustomerTotalPages)
                            {
                                @Html.ActionLink("Next →", "Index", new
                                {
                                    staffPage = Model.StaffPage,
                                    customerPage = Model.CustomerPage + 1,
                                    productPage = Model.ProductPage
                                }, new { @class = "btn btn-outline-secondary btn-sm" })
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Product Section -->
    <div class="col-md-4">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="mb-0">Product Management</h5>
                    <small class="text-muted">Page @Model.ProductPage of @Model.ProductTotalPages</small>
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Brand</th>
                                <th>Category</th>
                                <th>Price</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var product in Model.Products)
                            {
                                <tr>
                                    <td>@product.product_name</td>
                                    <td>@(product.Brand?.brand_name ?? "N/A")</td>
                                    <td>@(product.Category?.category_name ?? "N/A")</td>
                                    <td>$@product.list_price</td>
                                    <td>
                                        @Html.ActionLink("Edit", "EditProduct", new { id = product.product_id }, new { @class = "btn btn-sm btn-warning" })
                                        @Html.ActionLink("Delete", "DeleteProduct", new { id = product.product_id }, new { @class = "btn btn-sm btn-danger" })
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Product Pagination -->
                @if (Model.ProductTotalPages > 1)
                {
                    <div class="d-flex justify-content-between align-items-center mt-3">
                        <div>
                            @if (Model.ProductPage > 1)
                            {
                                @Html.ActionLink("← Previous", "Index", new
                                {
                                    staffPage = Model.StaffPage,
                                    customerPage = Model.CustomerPage,
                                    productPage = Model.ProductPage - 1
                                }, new { @class = "btn btn-outline-secondary btn-sm" })
                            }
                        </div>

                        <small class="text-muted">Page @Model.ProductPage of @Model.ProductTotalPages</small>

                        <div>
                            @if (Model.ProductPage < Model.ProductTotalPages)
                            {
                                @Html.ActionLink("Next →", "Index", new
                                {
                                    staffPage = Model.StaffPage,
                                    customerPage = Model.CustomerPage,
                                    productPage = Model.ProductPage + 1
                                }, new { @class = "btn btn-outline-secondary btn-sm" })
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>