@model u22730797_HW03.Models.MaintainViewModel
@{
    ViewBag.Title = "Maintain Records";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-md-12">
        <h1>Maintain Records</h1>
        <p class="lead">Manage Staff, Customers, and Products</p>
    </div>
</div>

<div class="row mt-4">
    <!-- Staff Section -->
    <div class="col-md-4">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="mb-0">Staff Management</h5>
                    <small class="text-muted">Page @Model.StaffPage of @Model.StaffTotalPages</small>
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Phone</th>
                                <th>Active</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var staff in Model.Staffs)
                            {
                                <tr>
                                    <td>@staff.first_name @staff.last_name</td>
                                    <td>@staff.email</td>
                                    <td>@staff.phone</td>
                                    <td>@(staff.active == 1 ? "Yes" : "No")</td>
                                    <td>
                                        <button class="btn btn-sm btn-warning" onclick="editStaff(@staff.staff_id)">Edit</button>
                                        <button class="btn btn-sm btn-danger" onclick="deleteStaff(@staff.staff_id)">Delete</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Staff Pagination -->
                @if (Model.StaffTotalPages > 1)
                {
                    <div class="d-flex justify-content-between align-items-center mt-3">
                        <div>
                            @if (Model.StaffPage > 1)
                            {
                                @Html.ActionLink("← Previous", "Index", new
                                {
                                    staffPage = Model.StaffPage - 1,
                                    customerPage = Model.CustomerPage,
                                    productPage = Model.ProductPage
                                }, new { @class = "btn btn-outline-secondary btn-sm" })
                            }
                        </div>

                        <small class="text-muted">Page @Model.StaffPage of @Model.StaffTotalPages</small>

                        <div>
                            @if (Model.StaffPage < Model.StaffTotalPages)
                            {
                                @Html.ActionLink("Next →", "Index", new
                                {
                                    staffPage = Model.StaffPage + 1,
                                    customerPage = Model.CustomerPage,
                                    productPage = Model.ProductPage
                                }, new { @class = "btn btn-outline-secondary btn-sm" })
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Customer Section -->
    <div class="col-md-4">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="mb-0">Customer Management</h5>
                    <small class="text-muted">Page @Model.CustomerPage of @Model.CustomerTotalPages</small>
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Phone</th>
                                <th>City</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var customer in Model.Customers)
                            {
                                <tr>
                                    <td>@customer.first_name @customer.last_name</td>
                                    <td>@customer.email</td>
                                    <td>@customer.phone</td>
                                    <td>@customer.city</td>
                                    <td>
                                        <button class="btn btn-sm btn-warning" onclick="editCustomer(@customer.customer_id)">Edit</button>
                                        <button class="btn btn-sm btn-danger" onclick="deleteCustomer(@customer.customer_id)">Delete</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Customer Pagination -->
                @if (Model.CustomerTotalPages > 1)
                {
                    <div class="d-flex justify-content-between align-items-center mt-3">
                        <div>
                            @if (Model.CustomerPage > 1)
                            {
                                @Html.ActionLink("← Previous", "Index", new
                                {
                                    staffPage = Model.StaffPage,
                                    customerPage = Model.CustomerPage - 1,
                                    productPage = Model.ProductPage
                                }, new { @class = "btn btn-outline-secondary btn-sm" })
                            }
                        </div>

                        <small class="text-muted">Page @Model.CustomerPage of @Model.CustomerTotalPages</small>

                        <div>
                            @if (Model.CustomerPage < Model.CustomerTotalPages)
                            {
                                @Html.ActionLink("Next →", "Index", new
                                {
                                    staffPage = Model.StaffPage,
                                    customerPage = Model.CustomerPage + 1,
                                    productPage = Model.ProductPage
                                }, new { @class = "btn btn-outline-secondary btn-sm" })
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Product Section -->
    <div class="col-md-4">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="mb-0">Product Management</h5>
                    <small class="text-muted">Page @Model.ProductPage of @Model.ProductTotalPages</small>
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Brand</th>
                                <th>Category</th>
                                <th>Price</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var product in Model.Products)
                            {
                                <tr>
                                    <td>@product.product_name</td>
                                    <td>@(product.Brand?.brand_name ?? "N/A")</td>
                                    <td>@(product.Category?.category_name ?? "N/A")</td>
                                    <td>$@product.list_price</td>
                                    <td>
                                        <button class="btn btn-sm btn-warning" onclick="editProduct(@product.product_id)">Edit</button>
                                        <button class="btn btn-sm btn-danger" onclick="deleteProduct(@product.product_id)">Delete</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Product Pagination -->
                @if (Model.ProductTotalPages > 1)
                {
                    <div class="d-flex justify-content-between align-items-center mt-3">
                        <div>
                            @if (Model.ProductPage > 1)
                            {
                                @Html.ActionLink("← Previous", "Index", new
                                {
                                    staffPage = Model.StaffPage,
                                    customerPage = Model.CustomerPage,
                                    productPage = Model.ProductPage - 1
                                }, new { @class = "btn btn-outline-secondary btn-sm" })
                            }
                        </div>

                        <small class="text-muted">Page @Model.ProductPage of @Model.ProductTotalPages</small>

                        <div>
                            @if (Model.ProductPage < Model.ProductTotalPages)
                            {
                                @Html.ActionLink("Next →", "Index", new
                                {
                                    staffPage = Model.StaffPage,
                                    customerPage = Model.CustomerPage,
                                    productPage = Model.ProductPage + 1
                                }, new { @class = "btn btn-outline-secondary btn-sm" })
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Edit Modals -->
    <div class="modal fade" id="editStaffModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Edit Staff</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" id="editStaffModalBody">
                    <!-- Content loaded via AJAX -->
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="editCustomerModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Edit Customer</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" id="editCustomerModalBody">
                    <!-- Content loaded via AJAX -->
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="editProductModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Edit Product</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" id="editProductModalBody">
                    <!-- Content loaded via AJAX -->
                </div>
            </div>
        </div>
    </div>

    <!-- Delete Confirmation Modal -->
    <div class="modal fade" id="deleteConfirmModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirm Delete</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete this item?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-danger" id="confirmDeleteBtn">Delete</button>
                </div>
            </div>
        </div>
    </div>
</div>
@section scripts {
    <script>
    let itemToDelete = null;
    let deleteUrl = null;

    // Staff functions
    function editStaff(staffId) {
        console.log('Editing staff:', staffId);
        $.get('@Url.Action("EditStaff", "Maintain")/' + staffId, function(data) {
            $('#editStaffModalBody').html(data);
            $('#editStaffModal').modal('show');
        }).fail(function(xhr, status, error) {
            console.log('Error loading staff edit form:', error);
            alert('Error loading staff form: ' + error);
        });
    }

    function deleteStaff(staffId) {
        itemToDelete = staffId;
        deleteUrl = '@Url.Action("DeleteStaff", "Maintain")';
        $('#deleteConfirmModal .modal-body p').text('Are you sure you want to delete this staff member?');
        $('#deleteConfirmModal').modal('show');
    }

    // Customer functions
    function editCustomer(customerId) {
        console.log('Editing customer:', customerId);
        $.get('@Url.Action("EditCustomer", "Maintain")/' + customerId, function(data) {
            $('#editCustomerModalBody').html(data);
            $('#editCustomerModal').modal('show');
        }).fail(function(xhr, status, error) {
            console.log('Error loading customer edit form:', error);
            alert('Error loading customer form: ' + error);
        });
    }

    function deleteCustomer(customerId) {
        itemToDelete = customerId;
        deleteUrl = '@Url.Action("DeleteCustomer", "Maintain")';
        $('#deleteConfirmModal .modal-body p').text('Are you sure you want to delete this customer?');
        $('#deleteConfirmModal').modal('show');
    }

    // Product functions
    function editProduct(productId) {
        console.log('Editing product:', productId);
        $.get('@Url.Action("EditProduct", "Maintain")/' + productId, function(data) {
            $('#editProductModalBody').html(data);
            $('#editProductModal').modal('show');
        }).fail(function(xhr, status, error) {
            console.log('Error loading product edit form:', error);
            console.log('Response:', xhr.responseText);
            alert('Error loading product form: ' + error);
        });
    }

    function deleteProduct(productId) {
        itemToDelete = productId;
        deleteUrl = '@Url.Action("DeleteProduct", "Maintain")';
        $('#deleteConfirmModal .modal-body p').text('Are you sure you want to delete this product?');
        $('#deleteConfirmModal').modal('show');
    }

    // Handle delete confirmation
    $('#confirmDeleteBtn').click(function() {
        if (itemToDelete && deleteUrl) {
            $.post(deleteUrl, { id: itemToDelete }, function(response) {
                if (response.success) {
                    $('#deleteConfirmModal').modal('hide');
                    // Preserve pagination after delete
                    window.location.href = '@Url.Action("Index", "Maintain", new {
                        staffPage = Model.StaffPage,
                        customerPage = Model.CustomerPage,
                        productPage = Model.ProductPage
                    })';
                } else {
                    alert('Error deleting item');
                }
            }).fail(function(xhr, status, error) {
                console.log('Delete error:', error);
                alert('Error deleting item: ' + error);
            });
        }
    });

    // Handle form submissions with pagination preservation
    $(document).on('submit', '#editStaffForm', function(e) {
        e.preventDefault();
        console.log('Submitting staff form');
        var form = $(this);
        var formData = form.serialize();
        console.log('Form data:', formData);

        $.ajax({
            url: form.attr('action'),
            type: 'POST',
            data: formData,
            success: function(response) {
                console.log('Staff response:', response);
                if (response.success) {
                    $('#editStaffModal').modal('hide');
                    // Preserve pagination after edit
                    window.location.href = '@Url.Action("Index", "Maintain", new {
                        staffPage = Model.StaffPage,
                        customerPage = Model.CustomerPage,
                        productPage = Model.ProductPage
                    })';
                } else {
                    $('#editStaffModalBody').html(response);
                }
            },
            error: function(xhr, status, error) {
                console.log('Staff AJAX error:', error);
                console.log('Status:', status);
                console.log('XHR:', xhr);
                alert('Error updating staff: ' + error);
            }
        });
    });

    $(document).on('submit', '#editCustomerForm', function(e) {
        e.preventDefault();
        console.log('Submitting customer form');
        var form = $(this);
        var formData = form.serialize();
        console.log('Form data:', formData);

        $.ajax({
            url: form.attr('action'),
            type: 'POST',
            data: formData,
            success: function(response) {
                console.log('Customer response:', response);
                if (response.success) {
                    $('#editCustomerModal').modal('hide');
                    // Preserve pagination after edit
                    window.location.href = '@Url.Action("Index", "Maintain", new {
                        staffPage = Model.StaffPage,
                        customerPage = Model.CustomerPage,
                        productPage = Model.ProductPage
                    })';
                } else {
                    $('#editCustomerModalBody').html(response);
                }
            },
            error: function(xhr, status, error) {
                console.log('Customer AJAX error:', error);
                alert('Error updating customer: ' + error);
            }
        });
    });

    $(document).on('submit', '#editProductForm', function (e) {
        e.preventDefault();
        console.log('Submitting product form');

        var form = $(this);
        var formData = form.serialize();
        console.log('Form data:', formData);

        // Client-side validation
        var brandId = $('#brand_id').val();
        var categoryId = $('#category_id').val();
        var modelYear = $('#model_year').val();
        var listPrice = $('#list_price').val();

        if (!brandId) {
            alert('Please select a brand');
            return;
        }

        if (!categoryId) {
            alert('Please select a category');
            return;
        }

        if (!modelYear || modelYear < 2000 || modelYear > 2025) {
            alert('Please enter a valid model year between 2000 and 2025');
            return;
        }

        // Simple price validation - server will handle the decimal conversion
        if (!listPrice) {
            alert('Please enter a valid price');
            return;
        }

        // Basic check if it's a valid number (with comma or dot)
        var priceRegex = /^\d+([,\.]\d+)?$/;
        if (!priceRegex.test(listPrice)) {
            alert('Please enter a valid price format (e.g., 749,99 or 749.99)');
            return;
        }

        $.ajax({
            url: form.attr('action'),
            type: 'POST',
            data: formData,
            success: function (response) {
                console.log('Product response:', response);
                if (response.success) {
                    $('#editProductModal').modal('hide');
                    // Preserve pagination after edit
                    window.location.href = '@Url.Action("Index", "Maintain", new {
                        staffPage = Model.StaffPage,
                        customerPage = Model.CustomerPage,
                        productPage = Model.ProductPage
                    })';
                } else {
                    alert('Error updating product: ' + response.errors);
                }
            },
            error: function (xhr, status, error) {
                console.log('Product AJAX error:', error);
                console.log('XHR response:', xhr.responseText);
                alert('Error updating product. Check console for details.');
            }
        });
    });
    </script>
}