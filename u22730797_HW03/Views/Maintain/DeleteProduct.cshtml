@model u22730797_HW03.Models.Product
@{
    ViewBag.Title = "Delete Product";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Delete Product</h2>

<div class="card">
    <div class="card-body">
        <h4>Are you sure you want to delete this product?</h4>

        <div class="alert alert-warning">
            <strong>Warning:</strong> This action cannot be undone.
        </div>

        <div class="row">
            <div class="col-md-6">
                <dl class="row">
                    <dt class="col-sm-4">Product Name:</dt>
                    <dd class="col-sm-8">@Model.product_name</dd>

                    <dt class="col-sm-4">Brand:</dt>
                    <dd class="col-sm-8">@(Model.Brand?.brand_name ?? "N/A")</dd>

                    <dt class="col-sm-4">Category:</dt>
                    <dd class="col-sm-8">@(Model.Category?.category_name ?? "N/A")</dd>

                    <dt class="col-sm-4">Model Year:</dt>
                    <dd class="col-sm-8">@Model.model_year</dd>

                    <dt class="col-sm-4">Price:</dt>
                    <dd class="col-sm-8">$@Model.list_price</dd>
                </dl>
            </div>
        </div>

        @using (Html.BeginForm("DeleteProduct", "Maintain", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(model => model.product_id)

            <div class="form-group">
                <button type="submit" class="btn btn-danger">Delete Product</button>
                @Html.ActionLink("Cancel", "Index", "Maintain", null, new { @class = "btn btn-secondary" })
            </div>
        }
    </div>
</div>