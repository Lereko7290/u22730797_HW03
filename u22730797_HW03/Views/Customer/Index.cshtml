@model List<u22730797_HW03.Models.Customer>
@{
    ViewBag.Title = "Customer Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Customer Management</h2>

<div class="card">
    <div class="card-header">
        <h5>All Customers</h5>
    </div>
    <div class="card-body">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>City</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var customer in Model)
                {
                    <tr>
                        <td>@customer.customer_id</td>
                        <td>@customer.first_name @customer.last_name</td>
                        <td>@customer.email</td>
                        <td>@customer.phone</td>
                        <td>@customer.city</td>
                        <td>
                            @Html.ActionLink("Edit", "Edit", new { id = customer.customer_id }, new { @class = "btn btn-sm btn-warning" })
                            @Html.ActionLink("Delete", "Delete", new { id = customer.customer_id }, new { @class = "btn btn-sm btn-danger" })
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>