@model List<u22730797_HW03.Models.Staff>
@{
    ViewBag.Title = "Staff Management";
}

<h2>Staff Management</h2>

<div class="card">
    <div class="card-header">
        <h5>All Staff Members</h5>
    </div>
    <div class="card-body">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Active</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var staff in Model)
                {
                    <tr>
                        <td>@staff.staff_id</td>
                        <td>@staff.first_name @staff.last_name</td>
                        <td>@staff.email</td>
                        <td>@staff.phone</td>
                        <td>@(staff.active == 1 ? "Yes" : "No")</td>
                        <td>
                            <a href="@Url.Action("Edit", "Staff", new { id = staff.staff_id })"
                               class="btn btn-sm btn-warning" data-toggle="modal" data-target="#editStaffModal">Edit</a>
                            <button class="btn btn-sm btn-danger" data-toggle="modal" data-target="#deleteStaffModal"
                                    onclick="setDeleteStaffId(@staff.staff_id)">
                                Delete
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editStaffModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Edit Staff</h5>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body" id="editStaffModalBody">
                <!-- Content will be loaded here -->
            </div>
        </div>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteStaffModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Delete Staff</h5>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete this staff member?</p>
            </div>
            <div class="modal-footer">
                @using (Html.BeginForm("Delete", "Staff", FormMethod.Post))
                {
                    @Html.Hidden("id", "", new { id = "deleteStaffId" })
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Delete</button>
                }
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        // Load edit form when modal is shown
        $('#editStaffModal').on('show.bs.modal', function (event) {
            var button = $(event.relatedTarget); // Button that triggered the modal
            var url = button.attr('href'); // Extract info from data-* attributes
            var modal = $(this);

            // Load the form via AJAX
            $.get(url, function (data) {
                modal.find('.modal-body').html(data);
            });
        });

        function setDeleteStaffId(staffId) {
            $('#deleteStaffId').val(staffId);
        }

        // Handle edit form submission via AJAX
        $(document).on('submit', '#editStaffForm', function (e) {
            e.preventDefault();
            var form = $(this);
            $.ajax({
                url: form.attr('action'),
                type: 'POST',
                data: form.serialize(),
                success: function (response) {
                    if (response.success) {
                        $('#editStaffModal').modal('hide');
                        location.reload(); // Refresh the page
                    } else {
                        $('#editStaffModal .modal-body').html(response);
                    }
                }
            });
        });
    </script>
}