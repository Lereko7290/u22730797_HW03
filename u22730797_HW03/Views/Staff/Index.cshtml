@model List<u22730797_HW03.Models.Staff>
@{
    ViewBag.Title = "Staff Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Staff Management</h2>

<div class="card">
    <div class="card-header">
        <h5>All Staff Members</h5>
    </div>
    <div class="card-body">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Active</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var staff in Model)
                {
                    <tr>
                        <td>@staff.staff_id</td>
                        <td>@staff.first_name @staff.last_name</td>
                        <td>@staff.email</td>
                        <td>@staff.phone</td>
                        <td>@(staff.active == 1 ? "Yes" : "No")</td>
                        <td>
                            @Html.ActionLink("Edit", "Edit", new { id = staff.staff_id }, new { @class = "btn btn-sm btn-warning" })
                            @Html.ActionLink("Delete", "Delete", new { id = staff.staff_id }, new { @class = "btn btn-sm btn-danger" })
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>